#!/bin/sh
# A fake `brew` for tests/e2e.rs and run-with-fake-brew.sh, installed as
# <dir>/bin/brew. It answers from fixture files in <dir> and logs every call
# to <dir>/calls.log. Upgrades take FAKE_BREW_UPGRADE_SECONDS (default 0)
# and fail with the contents of <dir>/upgrade-stderr when it exists.
dir="$(cd "$(dirname "$0")/.." && pwd)"
echo "$*" >>"$dir/calls.log"
case "$1 $3" in
  outdated*) cat "$dir/outdated.json" ;;
  "info --formula") cat "$dir/info-formula.json" ;;
  "info --cask") cat "$dir/info-cask.json" ;;
  upgrade*)
    sleep "${FAKE_BREW_UPGRADE_SECONDS:-0}"
    if [ -f "$dir/upgrade-stderr" ]; then
      cat "$dir/upgrade-stderr" >&2
      exit 1
    fi
    echo "fake brew: $*" ;;
  *) exit 1 ;;
esac
